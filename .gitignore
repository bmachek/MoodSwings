# Rust build artifacts (several GB)
/target/

# Quick saves
/saves/

# macOS
.DS_Store

# Scanned PBR materials, fetched by tools/fetch-materials.sh (~143 MB)
/assets/materials/

# Recorded CC0 sounds, fetched by the same script; the bank synthesises
# whatever is missing
/assets/sounds/

# Working before/after comparisons for a phase. The README gallery is what
# ships -- the tracked `shots/*.png` -- and every subdirectory under it is
# scratch from a `tools/shoot.sh --out` run.
#
# This used to name `shots/before/` and `shots/after/` specifically, which
# covered two of the seventy directories that have accumulated. A `git add -A`
# then swept two thousand seven hundred captures into a commit and took the
# repository to four gigabytes. One rule for all of them.
shots/*/

# Auditioned sound, written by `cargo run -- --audition`
/shots/audio/
__pycache__/

# Claude Code. The agent configuration is part of the project and is tracked —
# the subagent roster, the slash commands, the permission allow-list and the
# hooks are the same kind of thing as tools/shoot.sh, and an agent that has to
# rediscover the traps every session is an agent that walks into them. What a
# session writes for *itself* — worktrees, transcripts, local overrides — is
# not.
/.claude/*
!/.claude/agents/
!/.claude/commands/
!/.claude/skills/
!/.claude/settings.json
/.claude/settings.local.json

# Local multiplayer server configuration
.env
